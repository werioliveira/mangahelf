# MangaShelf - Variáveis de ambiente (desenvolvimento)
# Copie este arquivo para .env e ajuste conforme necessário

# App
APP_ENV=development
PORT=8080
SESSION_SECRET=mude-esta-chave-secreta-em-producao

# Banco (Postgres — roda no WSL ou Docker)
DATABASE_URL=postgres://mangashelf:mangashelf@localhost:5432/mangashelf?sslmode=disable
DATA_DIR=./data

# Drivers
SEARCH_DRIVER=postgres
IMAGE_PIPELINE=imgproxy
STORAGE_DRIVER=s3
CACHE_DRIVER=memory
AUTH_DRIVER=builtin

# S3 / S3-compatível (MinIO, Garage, SeaweedFS, R2, B2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mangashelf
S3_ACCESS_KEY=mangashelf
S3_SECRET_KEY=mangashelf123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:8080

# Image pipeline (imgproxy)
IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_KEY=mude-esta-chave-imgproxy
IMGPROXY_SALT=mude-este-salt-imgproxy

# VIP
VIP_URL_TTL_MIN=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
