# App
APP_ENV=development
PORT=8080
SESSION_SECRET=mude-esta-chave-secreta-em-producao

# Banco (desativado por padrao; roda no WSL)
DATABASE_URL=postgres://mangashelf:mangashelf@localhost:5432/mangashelf?sslmode=disable
DATA_DIR=./data

# Drivers
SEARCH_DRIVER=postgres
IMAGE_PIPELINE=imgproxy
STORAGE_DRIVER=local
CACHE_DRIVER=memory
AUTH_DRIVER=builtin

# S3 (so quando STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# VIP
VIP_URL_TTL_MIN=10
